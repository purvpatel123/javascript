                     //squered of even number

const arr=[1, 2, 3, 4]

const result=arr.filter((i)=>{
    return i%2==0;
}).map((i)=>{
    return i=i*2
})

console.log(result)

                     //filter email of active user

  const users = [
  { name: 'Alice', email: 'a@mail.com', active: true },
  { name: 'Bob', email: 'b@mail.com', active: false },
  { name: 'Charlie', email: 'c@mail.com', active: true },
];


const result=users.filter((i)=>{
    return i.active==true;
}).map((i)=>{
    return i.email;
})

console.log(result) 


